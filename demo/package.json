{
  "name": "claims-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:web": "npm run ocr-assets && vite web",
    "build:web": "npm run ocr-assets && vite build web",
    "deploy:worker": "wrangler deploy -c wrangler.local.toml",
    "deploy:web": "npm run build:web && wrangler deploy -c wrangler.web.toml",
    "invite": "node scripts/invite.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "docx": "^9.8.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@xmldom/xmldom": "^0.9.12",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
