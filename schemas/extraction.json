  "additionalProperties": false,
  "description": "Case card extracted from all documents of one case.",
  "properties": {
    "developer_name": {
      "$ref": "#/$defs/Field_str_",
      "description": "Full name of the developer company as written in the agreement."
    },
    "agreement_reference": {
      "$ref": "#/$defs/Field_str_",
      "description": "Notarial deed reference of the development agreement, e.g. 'Rep. A nr 1234/2021'."
    },
    "agreement_date": {
      "$ref": "#/$defs/Field_date_",
      "description": "Date the development agreement was concluded (signed before the notary)."
    },
    "price_gross": {
      "$ref": "#/$defs/Field_Decimal_",
      "description": "Gross price of the unit in PLN."
    },
    "handover_deadline": {
      "$ref": "#/$defs/Field_date_",
      "description": "Contractual deadline to hand over the unit."
    },
    "transfer_deadline": {
      "$ref": "#/$defs/Field_date_",
      "description": "Contractual deadline to conclude the ownership transfer agreement."
    },
    "annex_deadlines": {
      "description": "Deadlines changed by annexes.",
      "items": {
        "$ref": "#/$defs/Field_AnnexDeadline_"
      },
      "title": "Annex Deadlines",
      "type": "array"
    },
    "penalty_basis": {
      "$ref": "#/$defs/Field_PenaltyBasis_"
    },
    "penalty_rate": {
      "$ref": "#/$defs/Field_Decimal_",
      "description": "Daily rate as a fraction (0.0002 = 0.02% per day) or PLN per day for fixed_per_day."
    },
    "penalty_cap": {
      "$ref": "#/$defs/Field_PenaltyCap_",
      "description": "Cap on the penalty; value null when no cap."
    },
    "penalty_events": {
      "$ref": "#/$defs/Field_list_PenaltyEvent__",
      "description": "Delays for which the contractual penalty is due."
    },
    "liability_exclusions": {
      "description": "Clauses excluding developer liability; value is a short label, quote the clause.",
      "items": {
        "$ref": "#/$defs/Field_str_"
      },
      "title": "Liability Exclusions",
      "type": "array"
    },
    "exclusive_penalty_clause": {
      "$ref": "#/$defs/Field_bool_",
      "description": "True when the buyer may not claim damages exceeding the penalty."
    },
    "waiver_of_claims": {
      "$ref": "#/$defs/Field_bool_",
      "description": "True when the buyer waived claims (usually in the transfer deed)."
    },
    "actual_handover_date": {
      "$ref": "#/$defs/Field_date_",
      "description": "Actual handover date from the protocol."
    },
    "actual_transfer_date": {
      "$ref": "#/$defs/Field_date_",
      "description": "Actual transfer date from the deed."
    }
  },
  "required": [
    "developer_name",
    "agreement_reference",
    "agreement_date",
    "price_gross",
    "handover_deadline",
    "transfer_deadline",
    "penalty_basis",
    "penalty_rate",
    "penalty_cap",
    "penalty_events",
    "exclusive_penalty_clause",
    "waiver_of_claims",
    "actual_handover_date",
    "actual_transfer_date"
  ],
  "title": "Extraction",
  "type": "object"
}
