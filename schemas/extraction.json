    "PenaltyBasis": {
      "enum": [
        "percent_of_price_per_day",
        "fixed_per_day",
        "statutory_interest",
        "other"
      ],
      "title": "PenaltyBasis",
      "type": "string"
    },
    "PenaltyCap": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "percent",
            "amount"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "For percent: fraction of price (0.05 = 5%). For amount: PLN.",
          "title": "Value"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "PenaltyCap",
      "type": "object"
    },
    "PenaltyEvent": {
      "enum": [
        "handover_delay",
        "transfer_delay"
      ],
      "title": "PenaltyEvent",
      "type": "string"
    }
