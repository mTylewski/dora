{
  "$defs": {
    "AnnexDeadline": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "field": {
          "enum": [
            "handover_deadline",
            "transfer_deadline"
          ],
          "title": "Field",
          "type": "string"
        },
        "annex_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annex number as written in the document; null if not numbered.",
          "title": "Annex No"
        }
      },
      "required": [
        "date",
        "field"
      ],
      "title": "AnnexDeadline",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Field_AnnexDeadline_": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnnexDeadline"
            },
            {
              "type": "null"
            }
          ],
          "description": "Extracted value; null when the document does not state it. Never guess."
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verbatim fragment of the document supporting the value; null when value is null.",
          "title": "Quote"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based page number in the source document.",
          "title": "Page"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the source document, e.g. doc_1.",
          "title": "Document Id"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "low"
        },
        "needs_review": {
          "default": false,
          "description": "Set by code after quote verification, never by the model.",
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "quote"
      ],
      "title": "Field[AnnexDeadline]",
      "type": "object"
    },
