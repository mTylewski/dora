# Copy to ${CLAIMS_ROOT}/config/.env (mode 600). Ansible generates it automatically.

CLAIMS_ROOT=/srv/claims
CLAIMS_IMAGE=ghcr.io/OWNER/claims-app@sha256:REPLACE

# Anthropic API key of the law firm's own account.
ANTHROPIC_API_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAIMS_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored analyses unreadable. Keep a copy in the firm's password manager.
CLAIMS_MAPPING_KEY=
POSTGRES_PASSWORD=

CLAIMS_RETENTION_DAYS=180
CLAIMS_REQUIRE_ANON_APPROVAL=true
CLAIMS_SECURE_COOKIES=true
CLAIMS_MAX_UPLOAD_MB=50

# Optional spaCy model for names/places (check the license first, see docs/).
# CLAIMS_SPACY_MODEL=pl_core_news_lg
